  "mrt_requirements": {
    "primary_radiation_fluxes": [
      {
        "symbol": "S_srf_dn",
        "name": "Surface solar radiation downwards",
        "ecmwf_variable": "ssrd",
        "ecmwf_paramId": 169,
        "description": "Total downward shortwave at surface (direct + diffuse)"
      },
      {
        "symbol": "S_srf_net",
        "name": "Surface net solar radiation",
        "ecmwf_variable": "ssr",
        "ecmwf_paramId": 176,
        "description": "Net shortwave = downward - upward"
      },
      {
        "symbol": "S_srf_dn_direct",
        "name": "Direct solar radiation at surface",
        "ecmwf_variable": "fdir",
        "ecmwf_paramId": 228021,
        "description": "Direct (beam) shortwave at surface"
      },
      {
        "symbol": "L_srf_dn",
        "name": "Surface thermal radiation downwards",
        "ecmwf_variable": "strd",
        "ecmwf_paramId": 175,
        "description": "Downward longwave at surface"
      },
      {
        "symbol": "L_srf_net",
        "name": "Surface net thermal radiation",
        "ecmwf_variable": "str",
        "ecmwf_paramId": 178,
        "description": "Net longwave = downward - upward"
      }
    ],
    "derived_quantities": [
      {
        "symbol": "L_srf_up",
        "equation": "L_srf_dn - L_srf_net",
        "equation_number": "3",
        "description": "Upward longwave from ground"
      },
      {
        "symbol": "S_srf_dn_diffuse",
        "equation": "S_srf_dn - S_srf_dn_direct",
        "equation_number": "4",
        "description": "Diffuse shortwave"
      },
      {
        "symbol": "S_srf_up",
        "equation": "S_srf_dn - S_srf_net",
        "equation_number": "5",
        "description": "Upward shortwave reflected from ground"
      }
    ],
    "solar_geometry": [
      {
        "symbol": "delta",
        "name": "Solar declination",
        "equation_number": "8",
        "derivable": true,
        "source": "Spencer (1971) via Di Napoli et al. (2020)"
      },
      {
        "symbol": "h",
        "name": "Hour angle",
        "equation_number": "9",
        "derivable": true,
        "source": "NOAA (1997) via Di Napoli et al. (2020)"
      },
      {
        "symbol": "theta_0",
        "name": "Solar zenith angle",
        "equation_number": "6",
        "derivable": true,
        "source": "Woan (2000) via Di Napoli et al. (2020)"
      },
      {
        "symbol": "gamma",
        "name": "Solar elevation angle",
        "equation_number": "16",
        "derivable": true,
        "source": "Di Napoli et al. (2020)"
      },
      {
        "symbol": "cos_theta_bar_0",
        "name": "Average daytime cosine of solar zenith angle",
        "equation_number": "12",
        "derivable": true,
        "source": "Hogan and Hirahara (2016) via Di Napoli et al. (2020)"
      }
    ],
    "mrt_equation": {
      "equation_number": "14",
      "formula": "MRT* = [1/sigma * (f_a*L_srf_dn + f_a*L_srf_up + (alpha_ir/epsilon_p)*f_a*S_srf_dn_diffuse + (alpha_ir/epsilon_p)*f_a*S_srf_up + f_p*I*)]^0.25",
      "constants": {
        "sigma": {
          "value": 5.67e-8,
          "units": "W/m2K4",
          "description": "Stefan-Boltzmann constant"
        },
        "f_a": {
          "value": 0.5,
          "description": "Angle factors for upper/lower hemispheres"
        },
        "alpha_ir": {
          "value": 0.7,
          "description": "Solar absorption coefficient of clothed human body"
        },
        "epsilon_p": {
          "value": 0.97,
          "description": "Emissivity of clothed human body"
        }
      }
    }
  },
